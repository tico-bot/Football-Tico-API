PORT=3100
NODE_ENV=development

# Opcional: exige X-API-Key em todas as rotas /api
# API_KEY=coloque-um-segredo-longo-aqui

# Provedor internacional/nacional complementar: https://www.football-data.org/
# Sem chave, o catálogo fica disponível, mas dados ao vivo retornam 503.
# FOOTBALL_DATA_API_KEY=
UPSTREAM_TIMEOUT_MS=8000

CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=250

# Limite por IP (exceto endpoint de saúde)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Origens CORS permitidas, separadas por vírgula. Vazio = qualquer origem.
# CORS_ORIGINS=https://meusite.com,https://outro.com
# Ative somente se a aplicação estiver atrás de um proxy confiável.
# TRUST_PROXY=false

# Somente para ambiente local: reutilizar o .env do Tico, sem copiar a chave.
# TICO_BOT_ENV_PATH=/caminho/ate/Tico-Bot/.env
